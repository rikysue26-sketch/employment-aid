# ============================================================
# 高校毕业生就业精准帮扶 Agent 平台 - 环境变量示例
# ============================================================

# 数据库 - PostgreSQL（本地或云端）
# 本地: postgresql://user:password@localhost:5432/employment
# 云端(Neon/Vercel Postgres): postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/employment?schema=public"

# AI 模式开关：mock | real
AI_MODE="mock"

# OpenAI 兼容接口配置（仅当 AI_MODE=real 时生效）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

PORT="3000"
